# JOBOS Environment Configuration
# Copy to .env and fill in your values

# Database
JOBOS_DB_HOST=localhost
JOBOS_DB_PORT=5432
JOBOS_DB_USER=jobos
JOBOS_DB_PASSWORD=jobos_dev
JOBOS_DB_NAME=jobos

# Vault — KMS provider: local (dev) | aws | gcp
JOBOS_VAULT_KMS_PROVIDER=local
JOBOS_VAULT_LOCAL_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# LLM — Platform trial credits (used for onboarding before tenant adds keys)
JOBOS_LLM_PLATFORM_GROQ_KEY=
JOBOS_LLM_PLATFORM_OPENROUTER_KEY=

# Composio
JOBOS_COMPOSIO_API_KEY=

# App
JOBOS_ENVIRONMENT=development
JOBOS_DEBUG=true
